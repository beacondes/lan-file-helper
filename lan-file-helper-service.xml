<service>
  <id>LanFileHelper</id>
  <name>LanFileHelper (文件助手)</name>
  <description>局域网文件助手 - Windows 端文件传输服务（网页 + 安卓分享）</description>
  <executable>%BASE%\lan-file-helper.exe</executable>
  <workingdirectory>%BASE%</workingdirectory>
  <logmode>rotate</logmode>
  <logpath>%BASE%\logs</logpath>
  <onfailure action="restart" delay="10 sec"/>
  <startmode>Automatic</startmode>
</service>
